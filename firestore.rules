rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/friends/$(a + '_' + b))
          || exists(/databases/$(database)/documents/friends/$(b + '_' + a));
    }

    // 내 항공편·운임·설정 원본: 나만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 친구에게 보여줄 요약(등급·진행률·다가오는 항공편): 쓰기는 나만, 읽기는 나와 친구만
    match /public/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid, request.auth.uid));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 초대 링크: 링크(토큰)를 아는 로그인 사용자만 한 건 조회 가능, 목록 조회 불가
    match /invites/{token} {
      allow get: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 친구 관계: 초대 링크가 있어야 만들 수 있고, 둘 중 누구나 끊을 수 있음
    match /friends/{pair} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pair == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.uid in request.resource.data.members
        && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.uid != request.auth.uid;
    }
  }
}
